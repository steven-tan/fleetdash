# Example fleetdash node config.
# provision-target.sh writes the real one to /etc/fleetdash/config.env.
# The hostnames below are PLACEHOLDERS — never commit real tailnet names.

FLEETDASH_LISTEN=:8080
FLEETDASH_NODE=fleetdash-dev
FLEETDASH_ENV=dev            # dev | stage | prod | node
FLEETDASH_CLOUD=azure        # aws | gcp | azure | home
FLEETDASH_REGION=eastus

# This node's view of the rest of the fleet — comma-separated base URLs:
FLEETDASH_PEERS=http://stage.example-tailnet.ts.net:8080,http://prod.example-tailnet.ts.net:8080,http://adm.example-tailnet.ts.net:8080
